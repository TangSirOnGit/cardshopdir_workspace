    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "recharts": "3.8.0",
    "sanitize-html": "^2.17.2",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
