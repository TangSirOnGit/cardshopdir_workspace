{
  "name": "cardshopdir",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:seed": "bun run lib/db/seed.ts",
    "email:dev": "email dev --dir emails",
    "setup": "bun run scripts/setup.ts",
    "promote-admin": "bun run scripts/promote-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1026.0",
    "@marsidev/react-turnstile": "^1.5.0",
    "@number-flow/react": "^0.6.0",
    "@react-email/components": "^1.0.11",
    "@tiptap/extension-bubble-menu": "^3.22.3",
    "@tiptap/extension-character-count": "^3.22.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-table": "^3.22.3",
    "@tiptap/extension-table-cell": "^3.22.3",
    "@tiptap/extension-table-header": "^3.22.3",
    "@tiptap/extension-table-row": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "ioredis": "^5.10.1",
    "leo-profanity": "^1.9.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "obscenity": "^0.4.6",
    "postgres": "^3.4.9",
