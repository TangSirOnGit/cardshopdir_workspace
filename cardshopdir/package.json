    "sileo": "^0.1.5",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.2",
