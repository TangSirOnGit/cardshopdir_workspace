# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cardshopdir:cardshopdir@localhost:5432/cardshopdir
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ── OAuth (Google / GitHub sign-in buttons) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Cloudflare R2 (production image uploads — dev falls back to disk) ───────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Hostname whitelisted for next/image (host of R2_PUBLIC_URL, e.g. cdn.yoursite.com)
NEXT_PUBLIC_CDN_HOSTNAME=

# ── Stripe (paid tiers + sponsor checkout) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# To test locally:
#   stripe login
#   stripe listen --forward-to localhost:3000/api/stripe/webhook

# ── Redis (rate limiting — defaults work with docker-compose) ────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Plunk (transactional emails + weekly newsletter) ─────────────────────────
PLUNK_SECRET_KEY=
PLUNK_PUBLIC_KEY=
PLUNK_FROM_EMAIL=

# ── Cron (bearer token for /api/cron/* endpoints) ────────────────────────────
CRON_SECRET=

# ── Cloudflare Turnstile (CAPTCHA on sign-in / sign-up / forgot-password) ───
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Discord (admin alerts on new signups + submissions) ──────────────────────
DISCORD_WEBHOOK_URL=

# ── Umami (self-hosted web analytics — script hidden when empty) ────────────
# Set to your Umami website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Dev scripts (recipient for seed + test-newsletter scripts) ──────────────
TEST_EMAIL=

